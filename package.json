{
  "packageManager": "bun@1.4.0",
  "engines": { "bun": ">=1.4.0" },
  "name": "google-photos-delete-tool",
  "version": "3.6.1",
  "private": true,
  "description": "Find and delete duplicate photos in Google Photos, and bulk delete safely — Chrome/Firefox extension and userscript",
  "author": "Sylphx <hi@sylphx.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "canary": "bun run scripts/canary/run.ts",
    "bench:engine": "bun run scripts/bench/engine.ts",
    "growth:readout": "bun run scripts/checkout-readout.ts",
    "verify": "bun run scripts/verify.ts",
    "zip": "bun run scripts/zip.ts",
    "size:check": "bun run scripts/size-budget.ts",
    "package": "bun run build && bun run verify && bun run zip",
    "license:keygen": "bun run scripts/license.ts keygen",
    "license:issue": "bun run scripts/license.ts issue",
    "license:verify": "bun run scripts/license.ts verify",
    "listing:check": "bun run scripts/listing.ts",
    "amo:bootstrap": "bun scripts/amo-create.mjs --zip google-photos-delete-tool-firefox.zip",
    "amo:bootstrap:dry": "bun scripts/amo-create.mjs --zip google-photos-delete-tool-firefox.zip --dry-run",
    "gf:upload": "bun scripts/greasy-fork-upload.mjs",
    "cws:listing": "bun scripts/cws-listing.mjs",
    "cws:screenshots": "bun scripts/cws-screenshots.mjs",
    "edge:bootstrap": "bun scripts/edge-bootstrap.mjs"
  },
  "devDependencies": {
    "@types/archiver": "6",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.2.0",
    "archiver": "^7.0.1",
    "eslint": "^9.19.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.62.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vitest": "^4.0.18"
  }
}
